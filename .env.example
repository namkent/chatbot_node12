# Cấu hình Server API Service cho UrChatbot (Node.js 12+)
PORT=3001

# Cấu hình OpenAI Compatible API (Groq, OpenRouter, OpenAI, Ollama, vLLM, DeepSeek...)
OPENAI_API_URL=https://api.groq.com/openai/v1/chat/completions
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=qwen/qwen3.8-27b

# (Tùy chọn) Tham số sinh AI
# AI_TEMPERATURE=0.6
# AI_MAX_TOKENS=8192
# AI_TOP_P=0.95

# (Tùy chọn) Kiểm tra chứng chỉ SSL/TLS trên Node 12 (mặc định tắt kiểm tra để tránh lỗi CA hết hạn trên Node 12)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Cấu hình MinIO S3 Compatible Service
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chatbot
MINIO_PUBLIC_URL=http://127.0.0.1:9000/chatbot
